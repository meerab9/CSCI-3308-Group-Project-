# Copy to .env.test (gitignored) before running the test suite.
# These are for the disposable test database only — never point this at
# a shared development or deployed database. POSTGRES_DB must end in
# _test; src/db.js refuses to connect otherwise when NODE_ENV=test.

NODE_ENV=test
POSTGRES_HOST=db-test
POSTGRES_PORT=5432
POSTGRES_USER=gitmatch_test
POSTGRES_PASSWORD=local-test-password
POSTGRES_DB=gitmatch_test
SESSION_SECRET=local-test-session-secret
