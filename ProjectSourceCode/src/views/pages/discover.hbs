<link rel="stylesheet" href="/resources/discover/discover.css">



    

    <!-- Main Discover Page -->
    <main class="discover-container">

        <!-- Page Heading -->
        <div class="discover-heading">
            <h1>Discover</h1>
            <p>Find people who share your interests and want to build something together.</p>
        </div>


        <!-- Filter Options -->
        <div class="filter-section">

            <button class="filter-btn active" data-filter="all">
                All
            </button>

            <button class="filter-btn" data-filter="software">
                Software
            </button>

            <button class="filter-btn" data-filter="hardware">
                Hardware
            </button>

            <button class="filter-btn" data-filter="design">
               Design
            </button>

            <button class="filter-btn" data-filter="ai">
                AI / Machine Learning
            </button>

        </div>


        <!-- Profile Feed -->
        <section class="profile-feed" id="profileFeed">

           

        </section>

        <div id="emptyState" class="empty-state" hidden>
            <i class="bi bi-people"></i>
            <h3>No more profiles</h3>
            <p>Check back later for more people to connect with.</p>
        </div>

    </main>


    <!-- Connection Confirmation Modal -->
    <div class="modal fade" id="connectionModal" tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-body text-center p-4">

                    <i class="bi bi-check-circle-fill success-icon"></i>

                    <h3>Connection Sent!</h3>

                    <p id="connectionMessage">
                        Your connection request has been sent.
                    </p>

                    <button class="btn btn-gm" data-bs-dismiss="modal">
                        Continue Discovering
                    </button>

                </div>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/resources/discover/discover.js"></script>


