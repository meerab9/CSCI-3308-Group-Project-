<div class="container py-5">

  <div class="card shadow-sm mx-auto" style="max-width: 750px;">

    <div class="card-body p-4">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="h3">
          My Profile
        </h1>

        <a href="/profile/edit"
           class="btn btn-primary">

          Edit Profile

        </a>

      </div>


      {{#if user.profile_picture}}

        <div class="text-center mb-4">

          <img
            src="{{user.profile_picture}}"
            alt="Profile picture"
            class="rounded-circle"
            width="150"
            height="150"
            style="object-fit: cover;"
          >

        </div>

      {{/if}}


      <h4>{{user.username}}</h4>

{{#if user.full_name}}
  <h5 class="text-muted">{{user.full_name}}</h5>
{{/if}}

{{#if user.bio}}
  <div class="mb-3 mt-3">
    <strong>About Me</strong>
    <p>{{user.bio}}</p>
  </div>
{{/if}}

{{#if user.major}}
  <p>
    <strong>Major:</strong>
    {{user.major}}
  </p>
{{/if}}

{{#if user.location}}
  <p>
    <strong>Location:</strong>
    {{user.location}}
  </p>
{{/if}}

      <hr>


      <p>
        <strong>School:</strong>
        {{user.school}}
      </p>


      <p>
        <strong>GitHub:</strong>
        {{user.github}}
      </p>


      <p>
        <strong>Computer Science Interests:</strong>
        {{user.cs_interests}}
      </p>


      <p>
        <strong>Other Interests:</strong>
        {{user.other_interests}}
      </p>

      {{#if user.skills.length}}
        <div class="mb-3">
          <strong>Skills:</strong>
          <div class="d-flex flex-wrap gap-2 mt-2">
            {{#each user.skills}}
              <span class="badge rounded-pill bg-primary">{{this}}</span>
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if user.structured_interests.length}}
        <div class="mb-3">
          <strong>Additional Interests:</strong>
          <div class="d-flex flex-wrap gap-2 mt-2">
            {{#each user.structured_interests}}
              <span class="badge rounded-pill bg-secondary">{{this}}</span>
            {{/each}}
          </div>
        </div>
      {{/if}}      

{{#if projects.length}}
  <hr>

  <h4 class="mb-3">My Projects</h4>

  {{#each projects}}
    <div class="card mb-3">
      <div class="card-body">

        <h5 class="card-title">{{project_name}}</h5>

        {{#if description}}
          <p class="card-text">{{description}}</p>
        {{/if}}

        {{#if project_url}}
          <a href="{{project_url}}"
             target="_blank"
             rel="noopener noreferrer"
             class="btn btn-outline-primary btn-sm mb-3">
            View Project
          </a>
        {{/if}}

        {{#if technologies.length}}
          <div>
            <strong>Technologies:</strong>
            <div class="d-flex flex-wrap gap-2 mt-2">
              {{#each technologies}}
                <span class="badge rounded-pill bg-info text-dark">
                  {{this}}
                </span>
              {{/each}}
            </div>
          </div>
        {{/if}}

      </div>
    </div>
  {{/each}}
{{/if}}

      <p>
        <strong>Looking For:</strong>
        {{user.looking_for}}
      </p>


{{#if projects.length}}
  <hr>

  <h4 class="mb-3">My Projects</h4>

  {{#each projects}}
    <div class="card mb-3">
      <div class="card-body">

        <h5 class="card-title">{{project_name}}</h5>

        {{#if description}}
          <p class="card-text">{{description}}</p>
        {{/if}}

        {{#if project_url}}
          <a href="{{project_url}}"
             target="_blank"
             rel="noopener noreferrer"
             class="btn btn-outline-primary btn-sm mb-3">
            View Project
          </a>
        {{/if}}

        {{#if technologies.length}}
          <div>
            <strong>Technologies:</strong>
            <div class="d-flex flex-wrap gap-2 mt-2">
              {{#each technologies}}
                <span class="badge rounded-pill bg-info text-dark">
                  {{this}}
                </span>
              {{/each}}
            </div>
          </div>
        {{/if}}

      </div>
    </div>
  {{/each}}
{{/if}}      <hr>


      <h4>Profile Prompts</h4>


      {{#each prompts}}

        <div class="card mb-3">

          <div class="card-body">

            <strong>
              {{prompt}}
            </strong>

            <p class="mb-0 mt-2">
              {{answer}}
            </p>

          </div>

        </div>

      {{else}}

        <p class="text-muted">
          No prompts have been answered yet.
        </p>

      {{/each}}

    </div>

  </div>

</div>
