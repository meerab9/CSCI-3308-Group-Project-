<div class="container my-5" style="max-width: 640px;">
  {{#if oauth}}
  <h2 class="mb-1">Finish setting up your profile</h2>
  <p class="text-muted mb-4">You're signed in with {{oauth.providerLabel}}. Just a few more details.</p>
  {{else}}
  <h2 class="mb-1">Create your account</h2>
  <p class="text-muted mb-4">Set up your profile so other students can find you.</p>
  {{/if}}
  {{> message}}

  {{#unless oauth}}
  <div class="d-grid gap-2 mb-3">
    {{#if googleEnabled}}
    <a href="/auth/google" class="btn btn-outline-dark btn-lg social-btn"><i class="bi bi-google"></i> Continue with Google</a>
    {{else}}
    <span class="d-grid" title="Google sign-in isn't configured yet"><button class="btn btn-outline-dark btn-lg social-btn" disabled><i class="bi bi-google"></i> Continue with Google</button></span>
    {{/if}}
    {{#if githubEnabled}}
    <a href="/auth/github" class="btn btn-dark btn-lg social-btn"><i class="bi bi-github"></i> Continue with GitHub</a>
    {{else}}
    <span class="d-grid" title="GitHub sign-in isn't configured yet"><button class="btn btn-dark btn-lg social-btn" disabled><i class="bi bi-github"></i> Continue with GitHub</button></span>
    {{/if}}
  </div>
  <div class="divider-text my-4"><span>or sign up with a username &amp; password</span></div>
  {{/unless}}

  <form action="{{#if oauth}}/register/complete{{else}}/register{{/if}}" method="POST" enctype="multipart/form-data" id="register-form" novalidate>

    <!-- Profile picture -->
    <div class="text-center mb-4">
      <label for="profile_picture" class="avatar-picker" title="Change profile picture">
        {{#if oauth.avatarUrl}}
        <img id="avatar-preview" class="avatar-img" src="{{oauth.avatarUrl}}" alt="Profile picture preview" referrerpolicy="no-referrer">
        <i id="avatar-placeholder" class="bi bi-person-circle avatar-placeholder d-none"></i>
        {{else}}
        <img id="avatar-preview" class="avatar-img d-none" alt="Profile picture preview">
        <i id="avatar-placeholder" class="bi bi-person-circle avatar-placeholder"></i>
        {{/if}}
        <span class="avatar-edit"><i class="bi bi-camera-fill"></i></span>
      </label>
      <input type="file" id="profile_picture" name="profile_picture"
             accept="image/png,image/jpeg,image/gif,image/webp" class="d-none">
      <div class="form-text">Click the icon to add a profile picture (max 2 MB)</div>
    </div>

    <!-- Account -->
    <h5 class="section-title">Account</h5>
    <div class="mb-3">
      <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
      <input type="text" class="form-control" id="username" name="username" value="{{form.username}}"
             required minlength="3" maxlength="50" pattern="[A-Za-z0-9_.\-]+" autocomplete="username">
      <div class="invalid-feedback">3-50 characters: letters, numbers, _ . or -</div>
    </div>
    {{#unless oauth}}
    <div class="row g-3 mb-3">
      <div class="col-sm-6">
        <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
        <input type="password" class="form-control" id="password" name="password"
               required minlength="8" autocomplete="new-password">
        <div class="invalid-feedback">At least 8 characters.</div>
      </div>
      <div class="col-sm-6">
        <label for="confirm_password" class="form-label">Confirm password <span class="text-danger">*</span></label>
        <input type="password" class="form-control" id="confirm_password" name="confirm_password"
               required autocomplete="new-password">
        <div class="invalid-feedback">Passwords must match.</div>
      </div>
    </div>

    {{/unless}}

    <!-- Profile -->
    <h5 class="section-title">Profile</h5>
    <div class="row g-3 mb-3">
      <div class="col-sm-6">
        <label for="github" class="form-label">GitHub</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-github"></i></span>
          <input type="text" class="form-control" id="github" name="github" value="{{form.github}}"
                 placeholder="username or profile link" maxlength="100">
        </div>
      </div>
      <div class="col-sm-6">
        <label for="school" class="form-label">School</label>
        <input type="text" class="form-control" id="school" name="school" value="{{form.school}}"
               placeholder="CU Boulder" maxlength="100">
      </div>
    </div>
    <div class="mb-3">
      <label for="cs_interests" class="form-label">Interests within computer science</label>
      <textarea class="form-control" id="cs_interests" name="cs_interests" rows="2" maxlength="500"
                placeholder="e.g. web dev, machine learning, systems">{{form.cs_interests}}</textarea>
    </div>
    <div class="mb-3">
      <label for="other_interests" class="form-label">Interests outside of computer science</label>
      <textarea class="form-control" id="other_interests" name="other_interests" rows="2" maxlength="500"
                placeholder="e.g. climbing, music, cooking">{{form.other_interests}}</textarea>
    </div>
    <div class="mb-4">
      <span class="form-label d-block">What are you looking for?</span>
      <div class="btn-group w-100" role="group" aria-label="Looking for">
        <input type="radio" class="btn-check" name="looking_for" id="lf-study" value="study" {{#if (eq lookingFor "study")}}checked{{/if}}>
        <label class="btn btn-outline-primary" for="lf-study">Just studying</label>
        <input type="radio" class="btn-check" name="looking_for" id="lf-friends" value="friends" {{#if (eq lookingFor "friends")}}checked{{/if}}>
        <label class="btn btn-outline-primary" for="lf-friends">Making friends</label>
        <input type="radio" class="btn-check" name="looking_for" id="lf-both" value="both" {{#if (eq lookingFor "both")}}checked{{/if}}>
        <label class="btn btn-outline-primary" for="lf-both">Both</label>
      </div>
    </div>

    <!-- Prompts -->
    <h5 class="section-title">Profile prompts <small class="text-muted fw-normal">(optional, up to 3)</small></h5>
    {{#each promptSlots}}
    <div class="card mb-3 prompt-card">
      <div class="card-body">
        <label for="prompt-{{index}}" class="form-label small text-muted">Prompt {{index}}</label>
        <select class="form-select mb-2 prompt-select" id="prompt-{{index}}" name="prompt">
          <option value="">Choose a prompt...</option>
          {{#each options}}
          <option value="{{this}}" {{#if (eq this ../selected)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <textarea class="form-control" name="prompt_answer" rows="2" maxlength="500"
                  aria-label="Answer to prompt {{index}}" placeholder="Your answer">{{answer}}</textarea>
      </div>
    </div>
    {{/each}}

    <button type="submit" class="btn btn-primary w-100 btn-lg mt-2">{{#if oauth}}Finish sign up{{else}}Create account{{/if}}</button>
  </form>
</div>
<script src="/resources/js/register.js"></script>
