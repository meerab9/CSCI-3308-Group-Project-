erDiagram
    USERS {
        varchar username PK
        char password "nullable, OAuth-only accounts"
        varchar profile_picture
        varchar github
        varchar school
        varchar cs_interests
        varchar other_interests
        varchar looking_for "study | friends | both"
        timestamp created_at
    }
    USER_PROMPTS {
        int prompt_id PK
        varchar username FK
        varchar prompt
        varchar answer
    }
    USER_IDENTITIES {
        varchar provider PK
        varchar provider_id PK
        varchar username FK
    }
    USERS ||--o{ USER_PROMPTS : "answers (max 3, app-enforced)"
    USERS ||--o{ USER_IDENTITIES : "signs in with"
